        info("Error", "Password must contain a Capital letter")              # Password must contain a Capital letter
    elif not any(char.isalnum() for char in password):
        info("Error", "Password must contain a special character")           # Password must contain a Special Character

    #LOGIC CHECK
    elif password!= confirm_password:
        info("Error","Passwords do not match")

    elif firstname == "":
