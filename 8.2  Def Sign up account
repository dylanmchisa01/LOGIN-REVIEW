    elif not firstname.isalpha():
            info("Error", "Firstname cannot contain special characters")
    elif surname == "":
        info("Error", "Surname field is empty")
    elif not surname.isalpha():
            info("Error", "Firstname cannot contain special characters")
    elif email == "":
        info("Error", "Email field is empty")
    elif "@" not in email or "." not in email:
        info("Error", "Invalid email format should be xxxxxx@xxxx.com")

