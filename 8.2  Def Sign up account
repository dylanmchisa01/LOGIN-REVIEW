    elif len(password) > 15:
        info("Error", "Password cannot be more than 15 characters")
    elif len(password) < 8 :                                      # Range of the password must be between 8 to 15
        info("Error", "Password cannot be less than 8 characters")

    #TYPE CHECK FOR PASSWORD
    elif not any(char.isdigit() for char in password):     
        info("Error", "Password must contain a number")                      # Password must contain a number  
